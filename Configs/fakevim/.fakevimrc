nnoremap <SPACE> <Nop>
let mapleader = " "

" highlight matched
set hlsearch
" case insensitive search
set ignorecase
set smartcase
" search while typing
set incsearch
" wrap-around when searching
set wrapscan
" show pressed keys in lower right corner
set showcmd
" tab -> spaces
set expandtab
set tabstop=4
set shiftwidth=4
" keep a 5 line buffer for the cursor from top/bottom of window
set scrolloff=5
" X11 clipboard
set clipboard=unnamed
" use ~ with movement
set notildeop

" clear highlighted search term on space
noremap <silent> <C-n> :nohls<CR>

" reselect visual block after indent
vnoremap < <gv
vnoremap > >gv

" MOVE LINE/BLOCK
nnoremap <C-S-j> :m .+1<CR>==
nnoremap <C-S-k> :m .-2<CR>==
inoremap <C-S-j> <Esc>:m .+1<CR>==gi
inoremap <C-S-k> <Esc>:m .-2<CR>==gi
vnoremap <C-S-j> :m '>+1<CR>gv=gv
vnoremap <C-S-k> :m '<-2<CR>gv=gv

" UPPERCASE the current word
inoremap <C-S-u> <Esc>gUiwea

" Use relative number
set relativenumber

" Qt Creator Actions
nnoremap <Space>ff :FilesInFileSystem<CR>
nnoremap gd :FollowSymbolUnderCursor<CR>
nnoremap gr :RenameSymbolUnderCursor<CR>
